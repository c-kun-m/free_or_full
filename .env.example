# Copy values into your shell environment; this file is not loaded automatically.
PA_HOST=127.0.0.1
PA_PORT=4318
PA_DATA_DIR=.local
PA_PROJECT_ROOT=.
# Use an actual codex executable, not a .cmd shell wrapper.
PA_CODEX_BIN=codex
# Optional: explicitly choose a model available to your signed-in Codex account.
# PA_CODEX_MODEL=
# Read-only by default. Opt into workspace-write on the desktop when ready.
PA_SANDBOX=read-only

# LangChain assistant model: use a tool-calling model available to your API account.
# This is separate from the Codex desktop sign-in. Values stay on the computer.
PA_AGENT_MODEL=
OPENAI_API_KEY=
