{
  "name": "phone-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "tsx apps/companion/src/main.ts",
    "build": "tsc",
    "start": "node dist/apps/companion/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:codex": "tsx scripts/codex-smoke.ts",
    "smoke:service": "pnpm build && tsx scripts/service-smoke.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@langchain/core": "^1.3.5",
    "@langchain/openai": "^1.8.2",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.2",
    "langchain": "^1.6.3",
    "selfsigned": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
